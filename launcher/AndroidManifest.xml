<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.rasha.omni">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-permission android:name="com.rasha.omni.permission.CINEMA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only for the HDMI preview experiment (docs/PLAN-NATIVE-OS.md); not granted unless the owner does it with appops. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Package visibility for a launcher: only launchable activities, plus the streaming apps the Watch tab can open. -->
    <queries>
        <package android:name="com.rasha.omni.weather" />
        <package android:name="com.rasha.omni.cinema" />
        <provider android:authorities="com.rasha.omni.cinema.catalogue" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="video/mp4" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="audio/mpeg" />
        </intent>
        <provider android:authorities="android.media.tv" />
        <package android:name="com.netflix.ninja" />
        <package android:name="com.disney.disneyplus" />
        <package android:name="com.amazon.amazonvideo.livingroom" />
    </queries>

    <application
        android:label="OMNI TvOS"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <activity
            android:name=".WeatherActivity"
            android:exported="false"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|locale|layoutDirection|uiMode" />
        <activity
            android:name=".HdmiProbeActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen" />
        <service android:name=".HdmiOverlay" android:exported="false" />
        <activity
            android:name=".HdmiViewerActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|locale|layoutDirection|uiMode" />
        <activity
            android:name=".TunerActivity"
            android:exported="false"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|locale|layoutDirection|uiMode" />
        <activity
            android:name=".PlayerActivity"
            android:exported="false"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|locale|layoutDirection|uiMode" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:resumeWhilePausing="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|locale|layoutDirection|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
