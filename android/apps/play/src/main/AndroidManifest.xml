<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- package visibility on Android 11: launchable apps, and the streaming clients we know how to recognise -->
    <queries>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
        <package android:name="com.limelight" />
        <package android:name="com.valvesoftware.steamlink" />
        <package android:name="com.nvidia.geforcenow" />
        <package android:name="com.microsoft.xcloud" />
        <package android:name="com.playstation.remoteplay" />
        <package android:name="com.parsec.client" />
        <package android:name="com.amazon.luna.client" />
        <package android:name="com.rasha.omni.control" />
    </queries>
    <application
        android:label="OMNI Play"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.OmniApp">
        <activity android:name=".PlayActivity" android:exported="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
