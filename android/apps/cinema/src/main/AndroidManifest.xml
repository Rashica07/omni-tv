<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Cinema lives inside the OMNI app but in its own process (Compose and the video player load only when it is opened). The permission still guards the catalogue provider and the deep-link door against other apps. -->
    <permission android:name="com.rasha.omni.permission.CINEMA" android:protectionLevel="signature" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <application>
        <activity android:name=".CinemaActivity" android:exported="false" android:process=":cinema" android:theme="@style/Theme.OmniApp" android:launchMode="singleTask"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|uiMode" />
        <activity android:name=".DeepLinkActivity" android:exported="true" android:process=":cinema" android:permission="com.rasha.omni.permission.CINEMA"
            android:excludeFromRecents="true" android:noHistory="true" android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="omni-cinema" />
            </intent-filter>
        </activity>
        <provider android:name=".CinemaProvider" android:authorities="com.rasha.omni.cinema.catalogue" android:exported="true" android:process=":cinema"
            android:readPermission="com.rasha.omni.permission.CINEMA" />
        <activity android:name=".PlayerActivity" android:exported="false" android:process=":cinema" android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|uiMode|smallestScreenSize|screenLayout" />
    </application>
</manifest>
